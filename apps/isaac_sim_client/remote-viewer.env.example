# Isaac Sim 4.2 installation and DT_SERVER checkout
ISAAC_SIM_DIR=/opt/isaac-sim-standalone-4.2.0
DT_SERVER_DIR=/opt/DT_SERVER

# Public IPv4 or mesh-VPN IPv4 that the remote browser can reach
ISAAC_PUBLIC_IP=100.80.10.20

# Frontend API viewer configuration (read by docker compose)
ISAAC_WEBRTC_PUBLIC_URL=http://100.80.10.20:8211
ISAAC_WEBRTC_SERVER=100.80.10.20
ISAAC_WEBRTC_INTERNAL_URL=http://100.80.10.20:8211
ISAAC_WEBRTC_ENABLED=true
ISAAC_WEBRTC_PATH=/streaming/webrtc-demo/
ISAAC_WEBRTC_WEB_PORT=8211
ISAAC_WEBRTC_SIGNAL_PORT=49100
ISAAC_WEBRTC_STREAM_PORT=47998

# Scene transport used by meta_sejong_script.py
ISAAC_SCENE_TRANSPORT=zenoh
ISAAC_ZENOH_ENDPOINT=100.80.10.10:7447
ISAAC_ZENOH_TOPIC=meta-sejong/scene/v1
ISAAC_USD_PATH=/data/2025_SejongUniv_All.usd

# Isaac Sim 4.2 installation and DT_SERVER checkout
ISAAC_SIM_DIR=/opt/isaac-sim-standalone-4.2.0
DT_SERVER_DIR=/opt/DT_SERVER

# Public IPv4 of the 3090 server. WebRTC advertises it for direct UDP media.
# Replace this TEST-NET address with the real server address.
ISAAC_PUBLIC_IP=203.0.113.10

# Browser-facing TCP endpoints are forwarded to these localhost ports by the
# VS Code Desktop Remote Tunnel. Do not use the app.github.dev HTTPS URL here.
ISAAC_WEBRTC_PUBLIC_URL=http://127.0.0.1:8211
ISAAC_WEBRTC_SERVER=127.0.0.1
ISAAC_WEBRTC_INTERNAL_URL=http://host.docker.internal:8211
ISAAC_WEBRTC_ENABLED=true
ISAAC_WEBRTC_PATH=/streaming/webrtc-demo/
ISAAC_WEBRTC_WEB_PORT=8211
ISAAC_WEBRTC_SIGNAL_PORT=49100
ISAAC_WEBRTC_SIGNAL_INTERNAL_HOST=host.docker.internal
# 10020/UDP is reserved for Zenoh on this deployment. Use another permitted
# UDP port for the WebRTC media stream.
ISAAC_WEBRTC_STREAM_PORT=10021

# Scene transport used by meta_sejong_script.py
ISAAC_SCENE_TRANSPORT=zenoh
ISAAC_ZENOH_ENDPOINT=udp/127.0.0.1:10020?rel=1
ISAAC_ZENOH_TOPIC=meta-sejong/scene/v1
ISAAC_USD_PATH=/data/2025_SejongUniv_All.usd

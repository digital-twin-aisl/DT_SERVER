--- a/vggt_omega/models/vggt_omega.py
+++ b/vggt_omega/models/vggt_omega.py
@@ -40,6 +40,41 @@ class VGGTOmega(nn.Module):
         with torch.autocast(device_type="cuda", dtype=amp_dtype):

+        return self._run_heads(aggregated_tokens_list, patch_token_start, images)
+
+    def forward_patch_tokens(
+        self,
+        patch_tokens: torch.Tensor,
+        images: torch.Tensor,
+    ) -> dict[str, torch.Tensor]:
+        """Run VGGT heads from DINO tokens produced by the same checkpoint."""
+        if len(images.shape) == 4:
+            images = images.unsqueeze(0)
+        if len(patch_tokens.shape) == 3:
+            patch_tokens = patch_tokens.unsqueeze(0)
+        if patch_tokens.shape[:2] != images.shape[:2]:
+            raise ValueError("patch token and image frame dimensions must match")
+
+        height, width = images.shape[-2:]
+        amp_dtype = torch.bfloat16 if torch.cuda.is_bf16_supported() else torch.float16
+        with torch.autocast(device_type="cuda", dtype=amp_dtype):
+            aggregated_tokens_list, patch_token_start = self.aggregator.forward_patch_tokens(
+                patch_tokens,
+                patch_grid_size=(
+                    height // self.aggregator.patch_size,
+                    width // self.aggregator.patch_size,
+                ),
+            )
+
+        return self._run_heads(aggregated_tokens_list, patch_token_start, images)
+
+    def _run_heads(
+        self,
+        aggregated_tokens_list: list[torch.Tensor | None],
+        patch_token_start: int,
+        images: torch.Tensor,
+    ) -> dict[str, torch.Tensor]:
+
         final_tokens = aggregated_tokens_list[-1]
